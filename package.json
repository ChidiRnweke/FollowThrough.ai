{
	"name": "followthrough.ai",
	"private": true,
	"version": "0.0.1",
	"type": "module",
	"scripts": {
		"dev": "NODE_OPTIONS='--import ./scripts/otel-instrumentation.js' vite dev",
		"build": "vite build",
		"preview": "vite preview",
		"start": "node --import ./scripts/otel-instrumentation.js build",
		"prepare": "svelte-kit sync || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"lint": "prettier --check . && eslint .",
		"format": "prettier --write .",
		"test:unit": "vitest run --project client --project server",
		"test:workflow": "vitest run --project server src/lib/controllers",
		"test:repository": "vitest run --project contracts",
		"test:capability": "vitest run --project server src/lib/services src/lib/server/domain",
		"test": "pnpm test:unit",
		"db:start": "docker compose up",
		"db:push": "drizzle-kit push",
		"db:generate": "drizzle-kit generate",
		"db:migrate": "drizzle-kit migrate",
		"db:studio": "drizzle-kit studio"
	},
