---
/**
 * A product screenshot with a light/dark pair — the app's screenshot-slot
 * recipe (full width, 2xl radius, hairline ring). The pair swaps with the
 * Starlight theme. Files live in docs/public/screenshots/<id>-{light,dark}.<ext>.
 * An SVG carries its own rounded panel, so it renders without the ring.
 */
interface Props {
	id: string;
	alt: string;
	caption?: string;
	ext?: 'jpg' | 'svg';
}

const { id, alt, caption, ext = 'jpg' } = Astro.props;
const base = `${import.meta.env.BASE_URL}screenshots/${id}`;
---

<figure class:list={['ft-shot', { 'ft-shot-plain': ext === 'svg' }]}>
	<img class="ft-shot-light" src={`${base}-light.${ext}`} {alt} loading="lazy" decoding="async" />
	<img class="ft-shot-dark" src={`${base}-dark.${ext}`} alt="" loading="lazy" decoding="async" />
	{caption && <figcaption>{caption}</figcaption>}
</figure>
