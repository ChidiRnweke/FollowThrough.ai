# Application configuration is loaded from Infisical by default.
# Keep application secrets in Infisical; this file contains bootstrap values only.
CONFIG_SOURCE=infisical
INFISICAL_CLIENT_ID=
INFISICAL_CLIENT_SECRET=
INFISICAL_PROJECT_ID=
INFISICAL_ENVIRONMENT=dev
INFISICAL_URL=https://app.infisical.com

# Platform key, not an application secret: adapter-node reads it at module load, so it
# can never come from Infisical. Prod gets it from the Dockerfile/compose instead.
BODY_SIZE_LIMIT=52428800
