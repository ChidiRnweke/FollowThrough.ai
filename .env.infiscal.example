# Import these application values into the root of the Infisical project.
# Replace deployment-specific credentials and endpoints before use.
# Required: there is no runtime default for these values.
DATABASE_URL=postgres://followthrough:followthrough@localhost:5432/followthrough
OPENROUTER_API_KEY=replace-me
MISTRAL_API_KEY=replace-me
# Authentication is required in every environment; there is no anonymous mode.
AUTHENTIK_DOMAIN=https://auth.example.com
AUTHENTIK_CLIENT_ID=replace-me
AUTHENTIK_CLIENT_SECRET=replace-me
AUTHENTIK_CALLBACK_URL=http://localhost:5173/auth/callback

# Optional: the application uses these defaults when a value is absent or blank.
DB_NAME=followthrough
DB_USER=followthrough
ORIGIN=http://localhost:5173

OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_DEFAULT_MODEL=openai/gpt-5.6
OPENROUTER_RECOMMENDED_MODELS=openai/gpt-5.6,anthropic/claude-sonnet-4.5
OPENROUTER_INLINE_MODEL=deepseek/deepseek-v4-flash
OPENROUTER_ATTACHMENT_VISION_MODEL=google/gemini-2.5-flash-lite

RETRIEVAL_CHUNK_TOKENS=2400
RETRIEVAL_CHUNK_OVERLAP_TOKENS=480

S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_ACCESS_KEY_ID=followthrough
S3_SECRET_ACCESS_KEY=followthrough-local-secret
S3_BUCKET=followthrough-attachments
S3_FORCE_PATH_STYLE=true

EVAL_RECORD=0
EVAL_STRICT_CACHE=0
EVAL_MODEL=openai/gpt-5.6
EVAL_JUDGE_MODEL=deepseek/deepseek-v4-pro
EVAL_GATE=0

# Attachment OCR via Mistral Document AI, called directly rather than through
# OpenRouter. Documents are fetched from a presigned object-storage URL, so the
# bucket must be reachable from Mistral. Images extracted from a document are
# described by OPENROUTER_ATTACHMENT_VISION_MODEL.
MISTRAL_BASE_URL=https://api.mistral.ai/v1
MISTRAL_OCR_MODEL=mistral-ocr-latest

# Archive decompression admission; rejects the whole archive before expansion.
ARCHIVE_MAX_EXPANDED_BYTES=26214400
ARCHIVE_MAX_ENTRIES=2000
